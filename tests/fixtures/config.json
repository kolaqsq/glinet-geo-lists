{
  "options": {
    "router_max_lines": 50,
    "router_max_ips": 10
  },
  "sources": {
    "geosite": [
      {"name": "yml", "type": "v2fly-plain-yml", "url": "https://example.test/dlc.yml", "min_lists": 2},
      {"name": "dat", "type": "v2ray-dat", "url": "https://example.test/geosite.dat",
       "sha256_url": "https://example.test/geosite.dat.sha256sum"}
    ],
    "geoip": [
      {"name": "dir", "type": "github-dir", "repo": "test/geoip", "ref": "release", "path": "text"}
    ]
  },
  "presets": {
    "ru-direct": {
      "include": ["geosite:category-ru", "geosite:extra@!ads", "geoip:ru", "file:custom.txt"],
      "min_lines": 5
    },
    "v6": {
      "include": ["geoip6:ru"]
    }
  }
}
